<Project Sdk="Microsoft.NET.Sdk">

  <!-- What plugins build against: device snapshots, the driver interface, HID/Bluetooth transport and shared driver plumbing. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PeripheralHub</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PeripheralHub.Core" />
    <InternalsVisibleTo Include="PeripheralHub.Tests" />
  </ItemGroup>

</Project>
