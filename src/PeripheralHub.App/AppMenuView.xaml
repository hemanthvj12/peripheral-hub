<UserControl x:Class="PeripheralHub.App.AppMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <!-- The app's menu (owner, 2026-10-28; replaced the Windows Forms tray menu): grouped sections, switches for on/off
         settings, icons for actions, version in a footer. Shown in AppMenuWindow (tray right-click) and in a pop-up in
         the panel (its ⋯ button), so opening it from the panel doesn't take focus away from the panel. -->
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="10,8,10,4"/>
        </Style>
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>

        <!-- A row: icon, label, and (for settings) a switch on the right showing Tag (true = on). -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- The switch: off = grey track, knob left; on = accent track, knob right. Bound to the row's Tag (a bool)
             through visibility, since template triggers on Tag didn't fire elsewhere in this app. -->
        <ControlTemplate x:Key="Switch" TargetType="ContentControl">
            <Grid Width="32" Height="16" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border CornerRadius="8" Background="{DynamicResource Track}" BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1"/>
                <Ellipse Width="8" Height="8" HorizontalAlignment="Left" Margin="4,0" Fill="{DynamicResource TextSecondary}"/>
                <Border CornerRadius="8" Background="{DynamicResource Accent}"
                        Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right" Margin="3,0" Fill="White"/>
                </Border>
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <StackPanel Margin="6" Width="280">
        <TextBlock Text="Widget" Style="{StaticResource SectionHeader}"/>
        <Button x:Name="WidgetRow" Style="{StaticResource MenuRow}" Click="OnWidgetClick">
            <DockPanel>
                <ContentControl DockPanel.Dock="Right" Template="{StaticResource Switch}"/>
                <TextBlock Text="&#xE737;" Style="{StaticResource RowIcon}"/>
                <TextBlock Text="Show widget" Style="{StaticResource RowLabel}"/>
            </DockPanel>
        </Button>
        <Button x:Name="OnTopRow" Style="{StaticResource MenuRow}" Click="OnOnTopClick"
                ToolTip="Off: the widget sits on the desktop, below your windows. On: it stays above everything.">
            <DockPanel>
                <ContentControl DockPanel.Dock="Right" Template="{StaticResource Switch}"/>
                <TextBlock Text="&#xE718;" Style="{StaticResource RowIcon}"/>
                <TextBlock Text="Always on top" Style="{StaticResource RowLabel}"/>
            </DockPanel>
        </Button>


        <Border Style="{StaticResource Separator}"/>
        <TextBlock Text="Controllers" Style="{StaticResource SectionHeader}"/>
        <Button x:Name="VirtualRow" Style="{StaticResource MenuRow}" Click="OnVirtualClick"
                ToolTip="Controllers created by apps such as DSX or game streaming. They have no real battery level.">
            <DockPanel>
                <ContentControl DockPanel.Dock="Right" Template="{StaticResource Switch}"/>
                <TextBlock Text="&#xE7FC;" Style="{StaticResource RowIcon}"/>
                <TextBlock Text="Show virtual controllers" Style="{StaticResource RowLabel}"/>
            </DockPanel>
        </Button>
        <!-- Sony controllers on Bluetooth (owner, 2026-10-29, after trying a Basic/Full picker): on (default) = switch
             them to full mode to read the battery; off = leave them in basic mode so every app gets input. Only shown
             while a Sony controller is paired over Bluetooth. -->
        <Button x:Name="SonyBatteryRow" Style="{StaticResource MenuRow}" Click="OnSonyBatteryClick">
            <Button.ToolTip>
                <ToolTip MaxWidth="430">
                    <TextBlock TextWrapping="Wrap">On: Full mode, so its battery shows; browsers and old games miss its input.<LineBreak/>Off: Basic mode, so input works everywhere; its battery isn't shown.<LineBreak/>After turning it off, turn the controller off and on.</TextBlock>
                </ToolTip>
            </Button.ToolTip>
            <DockPanel>
                <ContentControl DockPanel.Dock="Right" Template="{StaticResource Switch}"/>
                <TextBlock Text="&#xE7FC;" Style="{StaticResource RowIcon}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                <TextBlock Text="Show Sony controller battery over Bluetooth" Style="{StaticResource RowLabel}" TextWrapping="Wrap"/>
            </DockPanel>
        </Button>
        <Button x:Name="HidHideRow" Style="{StaticResource MenuRow}" Click="OnHidHideClick">
            <DockPanel>
                <ContentControl DockPanel.Dock="Right" Template="{StaticResource Switch}"/>
                <TextBlock Text="&#xE7B3;" Style="{StaticResource RowIcon}"/>
                <TextBlock Text="Show hidden controllers" Style="{StaticResource RowLabel}"/>
            </DockPanel>
        </Button>

        <Border Style="{StaticResource Separator}"/>
        <TextBlock Text="App" Style="{StaticResource SectionHeader}"/>
        <Button x:Name="StartupRow" Style="{StaticResource MenuRow}" Click="OnStartupClick">
            <DockPanel>
                <ContentControl DockPanel.Dock="Right" Template="{StaticResource Switch}"/>
                <TextBlock Text="&#xE7E8;" Style="{StaticResource RowIcon}"/>
                <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}"/>
            </DockPanel>
        </Button>
        <Button x:Name="UpdateRow" Style="{StaticResource MenuRow}" Click="OnUpdateClick">
            <DockPanel>
                <TextBlock Text="&#xE896;" Style="{StaticResource RowIcon}"/>
                <TextBlock x:Name="UpdateText" Text="Get new versions…" Style="{StaticResource RowLabel}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Button>
        <Button Style="{StaticResource MenuRow}" Click="OnLogClick">
            <DockPanel>
                <TextBlock Text="&#xE838;" Style="{StaticResource RowIcon}"/>
                <TextBlock Text="Open log folder" Style="{StaticResource RowLabel}"/>
            </DockPanel>
        </Button>
        <Button Style="{StaticResource MenuRow}" Click="OnExitClick">
            <DockPanel>
                <TextBlock Text="&#xE711;" Style="{StaticResource RowIcon}"/>
                <TextBlock Text="Exit" Style="{StaticResource RowLabel}"/>
            </DockPanel>
        </Button>

        <TextBlock x:Name="VersionText" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="10,8,10,4"/>
    </StackPanel>
</UserControl>
