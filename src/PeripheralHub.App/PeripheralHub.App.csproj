<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PeripheralHub.App</RootNamespace>
    <AssemblyName>PeripheralHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by IconFactory (run the app with the write-icon option to regenerate). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- WFAC010 asks WinForms apps to set DPI mode in code; this is a WPF app, where app.manifest is the right place. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>1.0.0</Version>
    <Product>PeripheralHub</Product>
    <Description>Battery, connection and status for your mice, keyboards and controllers.</Description>
    <!-- Program.Main runs Velopack (installer/updater hooks) before WPF starts, so App.xaml isn't the entry point. -->
    <StartupObject>PeripheralHub.App.Program</StartupObject>
    <!-- Memory (measured 2026-10-31, see CLAUDE.md): DATAS (server GC that adapts to a small heap) keeps a 2 MB gen0
         budget instead of 16 MB, and without tiered compilation methods are compiled once instead of again later,
         which also stops memory from creeping up during the first hour. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Device pictures, drawn at runtime by LineArt (Art\README.md says where they come from). -->
    <EmbeddedResource Include="Art\*.svg" LogicalName="PeripheralHub.App.Art.%(Filename).svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep in step with the vpk tool version in .config/dotnet-tools.json. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- install.ps1 and build-installer.ps1 publish a single framework-dependent exe (needs the .NET 8 Desktop Runtime;
       the Setup built by build-installer.ps1 installs it when missing). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF names unambiguous: WinForms/Drawing types are referenced explicitly where used. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PeripheralHub.Core\PeripheralHub.Core.csproj" />
    <!-- Built-in plugins: built first (not referenced), then shipped as plugins\<id>\ folders next to the exe. -->
    <ProjectReference Include="..\..\plugins\*\*.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- The plugin projects stage themselves in artifacts\plugins\<Configuration> (see plugins\Directory.Build.targets). -->
  <Target Name="CopyPluginsToOutput" AfterTargets="Build">
    <ItemGroup>
      <StagedPluginFile Include="$(MSBuildThisFileDirectory)..\..\artifacts\plugins\$(Configuration)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)plugins" />
    <Copy SourceFiles="@(StagedPluginFile)" DestinationFiles="@(StagedPluginFile->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CopyPluginsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <StagedPluginFile Include="$(MSBuildThisFileDirectory)..\..\artifacts\plugins\$(Configuration)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="@(StagedPluginFile)" DestinationFiles="@(StagedPluginFile->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
