<!--
    Pictures for devices without their own product image (owner's choice 2026-10-29, "Silver + brand"): silver
    bodies like the real product renders, with the app's purple-to-blue on the details (screen, wheel, ear pads,
    buttons). Drawn on a 120x84 canvas (the tiles' picture ratio); a transparent frame keeps every picture's framing
    the same. The Silver icon pack's pictures for everything but controllers (DeviceArt.For looks them up by key;
    controllers are the pack's line art filled the same way, DeviceArt.Silver; Generic.Controller is unused).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="Silver" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F4F6FA"/>
        <GradientStop Offset="1" Color="#A9B0BD"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brand" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#9B6BFF"/>
        <GradientStop Offset="1" Color="#3F8CFF"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Detail" Color="#5B6170"/>
    <SolidColorBrush x:Key="Dark" Color="#1D2230"/>
    <SolidColorBrush x:Key="Keys" Color="#C9CED8"/>
    <RectangleGeometry x:Key="Frame" Rect="0,0,120,84"/>

    <DrawingImage x:Key="Generic.Monitor">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Frame}"/>
                <GeometryDrawing Brush="{StaticResource Silver}"><GeometryDrawing.Geometry><RectangleGeometry Rect="12,6,96,58" RadiusX="6" RadiusY="6"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Brand}"><GeometryDrawing.Geometry><RectangleGeometry Rect="17,11,86,46" RadiusX="2.5" RadiusY="2.5"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Detail}"><GeometryDrawing.Geometry><RectangleGeometry Rect="54,64,12,9"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Silver}"><GeometryDrawing.Geometry><RectangleGeometry Rect="36,72,48,6" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Keyboard (owner, 2026-10-29: clearer keys): silver frame, dark graphite deck, bright keycaps, and W A S D + space
         in the brand gradient. Letters in three rows (Q, A and Z rows), then a modifier/space row. -->
    <LinearGradientBrush x:Key="KeyCap" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF"/>
        <GradientStop Offset="1" Color="#CDD3DD"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Deck" Color="#2E323B"/>
