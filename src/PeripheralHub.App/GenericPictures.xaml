        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Frame}"/>
                <GeometryDrawing Brush="{StaticResource Silver}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup FillRule="Nonzero">
                            <RectangleGeometry Rect="33,32,10,44" RadiusX="5" RadiusY="5"/>
                            <EllipseGeometry Center="42,28" RadiusX="15" RadiusY="13"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Silver}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup FillRule="Nonzero">
                            <RectangleGeometry Rect="77,32,10,44" RadiusX="5" RadiusY="5"/>
                            <EllipseGeometry Center="78,28" RadiusX="15" RadiusY="13"/>
