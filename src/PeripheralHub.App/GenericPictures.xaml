            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Generic.Mouse">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Frame}"/>
                <GeometryDrawing Brush="{StaticResource Silver}"><GeometryDrawing.Geometry><RectangleGeometry Rect="38,4,44,76" RadiusX="22" RadiusY="22"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Geometry="M60,5 V34 M39,34 H81"><GeometryDrawing.Pen><Pen Brush="{StaticResource Detail}" Thickness="2"/></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Brand}"><GeometryDrawing.Geometry><RectangleGeometry Rect="56.5,13,7,13" RadiusX="3.5" RadiusY="3.5"/></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="Generic.Audio">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="{StaticResource Frame}"/>
                <GeometryDrawing Geometry="M28,54 V44 A32,32 0 0 1 92,44 V54">
                    <GeometryDrawing.Pen><Pen Brush="{StaticResource Silver}" Thickness="7" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Silver}"><GeometryDrawing.Geometry><RectangleGeometry Rect="17,44,21,32" RadiusX="9" RadiusY="9"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Silver}"><GeometryDrawing.Geometry><RectangleGeometry Rect="82,44,21,32" RadiusX="9" RadiusY="9"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Brand}"><GeometryDrawing.Geometry><RectangleGeometry Rect="32,50,5,20" RadiusX="2.5" RadiusY="2.5"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Brand}"><GeometryDrawing.Geometry><RectangleGeometry Rect="83,50,5,20" RadiusX="2.5" RadiusY="2.5"/></GeometryDrawing.Geometry></GeometryDrawing>
                <!-- Boom mic: it's a headset (owner, 2026-10-29: headsets and earphones look different). -->
                <GeometryDrawing Geometry="M27,74 Q30,81 46,80">
                    <GeometryDrawing.Pen><Pen Brush="#C4C9D2" Thickness="3.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Brand}"><GeometryDrawing.Geometry><EllipseGeometry Center="49,79.5" RadiusX="4.5" RadiusY="3.5"/></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Earbuds (DevicePictures.IsEarbuds): two stem buds with brand-coloured ear tips and mics. -->
