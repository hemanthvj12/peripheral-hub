                <GeometryDrawing Brush="{StaticResource KeyCap}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="12.6,29.0,6.8,6.6" RadiusX="1.3" RadiusY="1.3"/>
                            <RectangleGeometry Rect="21.5,29.0,6.8,6.6" RadiusX="1.3" RadiusY="1.3"/>
                            <RectangleGeometry Rect="39.3,29.0,6.8,6.6" RadiusX="1.3" RadiusY="1.3"/>
                            <RectangleGeometry Rect="48.2,29.0,6.8,6.6" RadiusX="1.3" RadiusY="1.3"/>
