<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hub: scans devices, loads plugins, runs the generic Bluetooth driver and publishes snapshots. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PeripheralHub</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PeripheralHub.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PeripheralHub.Sdk\PeripheralHub.Sdk.csproj" />
  </ItemGroup>

</Project>
